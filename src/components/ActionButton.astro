---
interface Props {
  type?: "button" | "submit" | "reset";
  variant?: "primary";
  disabled?: boolean;
  class?: string;
}

const { type = "button", variant = "primary", disabled = false, class: className } = Astro.props;
const variantClass = {
  primary: "btn-gold rounded-sm",
}[variant];
---

<button type={type} disabled={disabled} class:list={[variantClass, className]}>
  <slot />
</button>
