---
interface Props {
  currentPage: number;
  totalPages: number;
  getPageHref: (page: number) => string;
  ariaLabel?: string;
}

const { currentPage, totalPages, getPageHref, ariaLabel = "Paginação" } = Astro.props;
---

{totalPages > 1 && (
  <nav class="pagination" aria-label={ariaLabel}>
    {currentPage > 1 && <a href={getPageHref(currentPage - 1)} rel="prev">Anterior</a>}
    {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
      <a href={getPageHref(page)} aria-label={`Página ${page}`} aria-current={page === currentPage ? "page" : undefined}>{page}</a>
    ))}
    {currentPage < totalPages && <a href={getPageHref(currentPage + 1)} rel="next">Próxima</a>}
  </nav>
)}
