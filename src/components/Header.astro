---
interface Props {
  isHomePage?: boolean;
}
import ContentSearch from "./ContentSearch.astro";

---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur shadow-sm">
  <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between" aria-label="Navegação principal">
    <a href="/" class="site-brand" data-site-brand>
      <img src="https://cdn.catedralanglicanabrasilia.org.br/logo_horizontal.png" alt="Catedral Anglicana da Ressurreição" width="313" height="172" />
    </a>
    <button class="menu-toggle min-w-11 min-h-11 items-center justify-center text-2xl" id="menuBtn" type="button" aria-controls="navLinks" aria-expanded="false">
      <span aria-hidden="true">☰</span><span class="sr-only" data-menu-label>Abrir menu</span>
    </button>
    <ul class="nav-links gap-7 text-sm font-medium list-none m-0 p-0" id="navLinks">
      <li><a href="/" class="nav-link">Home</a></li>
      <li class="nav-group">
        <button type="button" class="nav-group-toggle" aria-expanded="false" aria-controls="submenu-sobre">Sobre <span aria-hidden="true">▾</span></button>
        <ul id="submenu-sobre" class="nav-submenu" hidden>
          <li><a href="/pages/about" class="nav-link">Sobre nós</a></li>
          <li><a href="/pages/dean" class="nav-link">Reverenda Deã</a></li>
          <li><a href="/pages/reverends-gallery" class="nav-link">Galeria de reverendo(a)s</a></li>
          <li><a href="/pages/leadership" class="nav-link">Liderança</a></li>
        </ul>
      </li>
      <li class="nav-group">
        <button type="button" class="nav-group-toggle" aria-expanded="false" aria-controls="submenu-atividades">O que fazemos <span aria-hidden="true">▾</span></button>
        <ul id="submenu-atividades" class="nav-submenu" hidden>
          <li><a href="/news/" class="nav-link">Notícias</a></li>
          <li><a href="/events/" class="nav-link">Eventos</a></li>
          <li><a href="/programs/" class="nav-link">Ações sociais</a></li>
        </ul>
      </li>
      <li class="nav-group">
        <button type="button" class="nav-group-toggle" aria-expanded="false" aria-controls="submenu-contato">Fale conosco <span aria-hidden="true">▾</span></button>
        <ul id="submenu-contato" class="nav-submenu" hidden>
          <li><a href="/pages/contact" class="nav-link">Contato</a></li>
          <li><a href="/locations/catedral-anglicana-da-ressurreicao" class="nav-link">Endereço</a></li>
        </ul>
      </li>
      <li><a href="/pages/donate" class="nav-link">Doar</a></li>
    </ul>
    <ContentSearch />
  </nav>
</header>
