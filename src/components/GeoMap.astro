---
import { parseGeometry } from "../utils/geometry";

interface Props {
  geometry: string | null | undefined;
  type: "Point" | "Polygon";
  title: string;
  headingLevel?: 2 | 3;
}

const { geometry, type, title, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
const parsed = parseGeometry(geometry, type);
const coordinates = parsed?.type === "Point"
  ? encodeURIComponent(`${parsed.coordinates[1]},${parsed.coordinates[0]}`)
  : undefined;
---

{geometry && <section class="location-map-section">
  <Heading class="serif text-2xl font-bold mb-4">{title}</Heading>
  {parsed ? <>
    <div class="location-map" data-geometry={JSON.stringify(parsed)} role="region" aria-label={title} tabindex="0"></div>
    {coordinates && <p class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
      <a class="underline text-[var(--gold-dark)]" href={`https://www.google.com/maps/search/?api=1&query=${coordinates}`} target="_blank" rel="noopener noreferrer">Abrir endereço no Google Maps (nova aba)</a>
      <a class="underline text-[var(--gold-dark)]" href={`https://waze.com/ul?ll=${coordinates}&navigate=yes`} target="_blank" rel="noopener noreferrer">Abrir endereço no Waze (nova aba)</a>
    </p>}
    <noscript><p>Ative o JavaScript para visualizar o mapa interativo.</p></noscript>
  </> : <p>Mapa indisponível: coordenadas inválidas.</p>}
</section>}

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";

  document.querySelectorAll<HTMLElement>(".location-map[data-geometry]").forEach((container) => {
    const raw = container.dataset.geometry;
    if (!raw) return;

    try {
      const geometry = JSON.parse(raw) as GeoJSON.Point | GeoJSON.Polygon;
      const map = L.map(container, { scrollWheelZoom: false });
      L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      }).addTo(map);
      const layer = L.geoJSON(geometry, {
        pointToLayer: (_feature, latlng) => L.circleMarker(latlng, {
          radius: 9, color: "#6b4f1d", weight: 3, fillColor: "#c9a96e", fillOpacity: 1,
        }),
        style: { color: "#806127", weight: 3, fillOpacity: 0.2 },
      }).addTo(map);
      if (geometry.type === "Point") {
        map.setView([geometry.coordinates[1], geometry.coordinates[0]], 16);
      } else {
        map.fitBounds(layer.getBounds(), { padding: [20, 20], maxZoom: 16 });
      }
    } catch {
      container.textContent = "Não foi possível carregar o mapa.";
    }
  });
</script>

<style>
  .location-map-section { margin-block: 2rem; }
  .location-map { width: 100%; height: 22rem; max-height: 60vh; background: #e9e5dc; z-index: 0; }
</style>
