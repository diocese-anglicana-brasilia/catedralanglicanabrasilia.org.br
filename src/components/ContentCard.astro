---
import type { CardItem } from "../types/card";

interface Props {
  item: CardItem;
  headingLevel?: 2 | 3;
}

const { item, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
---

<article class="content-card">
  {item.image && <div class="content-card-media"><img src={item.image.src} alt={item.image.alt} loading="lazy" /></div>}
  <div class="content-card-content">
    {item.date && <time class="content-card-date" datetime={item.date.toISOString()}>{item.date.toLocaleDateString("pt-BR", { timeZone: "UTC" })}</time>}
    <Heading class="serif content-card-title"><a href={item.href}>{item.title}</a></Heading>
    {item.description && <p class="content-card-description">{item.description}</p>}
  </div>
</article>
