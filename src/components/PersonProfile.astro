---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

interface Props {
  name: string;
  role: string;
  bio?: string | null;
  imageSrc?: string;
  backHref: string;
  backLabel: string;
}

const { name, role, bio, imageSrc, backHref, backLabel } = Astro.props;
---

<BaseLayout title={`${name} | Catedral Anglicana da Ressureição`}>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo principal</a>
  <Header isHomePage={false} />
  <main id="conteudo" tabindex="-1" class="min-h-screen bg-[var(--cream)] px-6 py-32">
    <article class="max-w-4xl mx-auto bg-white p-8 md:p-12 rounded-sm shadow-sm">
      <h1 class="serif text-4xl md:text-5xl font-bold mb-4">{name}</h1>
      <p class="text-lg text-gray-700 mb-2">{role}</p>
      <slot name="details" />
      {imageSrc && <img src={imageSrc} alt={`Fotografia de ${name}`} class="w-full max-w-sm max-h-[32rem] object-cover mb-8" />}
      {bio && <div class="content-body text-gray-700 leading-relaxed whitespace-pre-line"><p>{bio}</p></div>}
      <div class="content-body text-gray-700 leading-relaxed"><slot /></div>
      <p class="mt-10"><a class="underline text-[var(--gold-dark)]" href={backHref}>{backLabel}</a></p>
    </article>
  </main>
  <Footer />
  <script>import "../scripts/site.js";</script>
</BaseLayout>
