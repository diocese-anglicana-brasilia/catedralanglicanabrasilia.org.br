---
import { getCollection } from "astro:content";
const entries = await getCollection("announcements", ({ data }) => data.status === "published");
const notices = entries.map(({ id, data }) => ({ ...data, id }));
---

{notices.length > 0 && <>
  <script is:inline id="announcements-data" type="application/json" set:html={JSON.stringify(notices).replace(/</g, "\\u003c")} />
  <aside class="announcement-banner" data-announcement-banner hidden aria-label="Aviso">
    <div><strong data-title></strong> <span data-message></span> <a data-link hidden></a></div>
    <button type="button" data-close aria-label="Fechar aviso">×</button>
  </aside>
  <dialog class="announcement-dialog" data-announcement-dialog aria-labelledby="announcement-title" aria-describedby="announcement-message">
    <h2 id="announcement-title" data-title></h2>
    <p id="announcement-message" data-message></p>
    <div class="announcement-actions"><a data-link hidden></a><button type="button" data-close>Fechar</button></div>
  </dialog>
  <script>import "../scripts/announcements.js";</script>
</>}
