---
import ActionButton from "./ActionButton.astro";
import FormField from "./FormField.astro";

const configuredEndpoint = import.meta.env.PUBLIC_PRAYER_API_URL?.trim();
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim();
let endpoint: string | undefined;
try {
  const url = new URL(configuredEndpoint ?? "");
  if (url.protocol === "https:" || (url.protocol === "http:" && ["localhost", "127.0.0.1"].includes(url.hostname))) endpoint = url.href;
} catch { /* O formulário permanece desativado. */ }
if (!siteKey) endpoint = undefined;
---

<form data-prayer-form data-prayer-endpoint={endpoint} method="post" class="bg-white p-8 rounded-sm shadow-lg space-y-4">
  <FormField id="prayer-name" label="Nome (opcional)">
    <input id="prayer-name" name="nome" type="text" autocomplete="name" maxlength="150" class="w-full border border-gray-300 rounded-sm px-4 py-2" />
  </FormField>
  <FormField id="prayer-message" label="Pedido de oração">
    <textarea id="prayer-message" name="mensagem" rows="5" maxlength="600" required class="w-full border border-gray-300 rounded-sm px-4 py-2"></textarea>
  </FormField>
  <p id="prayer-privacy" class="text-sm text-gray-700">Seu pedido será enviado para nossa Secretaria e lido na celebração dominical, junto com outros pedidos. Evite compartilhar dados sensíveis ou informações de outras pessoas sem autorização.</p>
  <label class="flex items-start gap-2 text-sm"><input type="checkbox" required aria-describedby="prayer-privacy" /><span>Estou ciente de como meu pedido será recebido.</span></label>
  {endpoint && <><div class="cf-turnstile" data-sitekey={siteKey}></div><script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script></>}
  <ActionButton type="submit" disabled={!endpoint} class="w-full py-3 font-semibold tracking-wide">Enviar pedido</ActionButton>
  <p data-form-status class="min-h-5 text-sm text-gray-600" role="status" aria-live="polite">{endpoint ? "" : <>O envio pelo formulário está temporariamente indisponível. Escreva para <a href="mailto:anglicana309sul@gmail.com" class="underline">anglicana309sul@gmail.com</a>.</>}</p>
</form>
