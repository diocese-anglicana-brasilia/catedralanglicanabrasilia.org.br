---
interface Props {
  id: string;
  imageSrc: string;
  overlayClass: string;
  contentClass: string;
  class?: string;
  loading?: "eager" | "lazy";
}

const { id, imageSrc, overlayClass, contentClass, class: className, loading = "lazy" } = Astro.props;
---

<section id={id} class:list={["relative py-28 img-section", className]}>
  <img src={imageSrc} alt="" aria-hidden="true" loading={loading} class="absolute inset-0 h-full w-full object-cover" />
  <div class:list={["absolute inset-0", overlayClass]}></div>
  <div class:list={["relative z-10", contentClass]}>
    <slot />
  </div>
</section>
