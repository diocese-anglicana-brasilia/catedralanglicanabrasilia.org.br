---
interface Props {
  start: Date;
  end?: Date | null;
  showTime?: boolean;
  timeZone?: string;
  precision?: "day" | "month";
}

const { start, end, showTime = false, timeZone = "UTC", precision = "day" } = Astro.props;
const formatter = new Intl.DateTimeFormat("pt-BR", {
  timeZone,
  ...(precision === "day" ? { day: "2-digit" as const } : {}),
  month: precision === "month" ? "long" : "2-digit",
  year: "numeric",
  ...(showTime ? { hour: "2-digit", minute: "2-digit", hourCycle: "h23" as const } : {}),
});
---

<span>
  {end && <span>Início: </span>}<time datetime={start.toISOString()}>{formatter.format(start)}</time>
  {end && <span> · Fim: <time datetime={end.toISOString()}>{formatter.format(end)}</time></span>}
</span>
