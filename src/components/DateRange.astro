---
interface Props {
  start: Date;
  end?: Date | null;
  showTime?: boolean;
  timeZone?: string;
  precision?: "day" | "month";
  period?: boolean;
}

const { start, end, showTime = false, timeZone = "UTC", precision = "day", period = false } = Astro.props;
const formatter = new Intl.DateTimeFormat("pt-BR", {
  timeZone,
  ...(precision === "day" ? { day: "2-digit" as const } : {}),
  month: precision === "month" ? "long" : "2-digit",
  year: "numeric",
  ...(showTime ? { hour: "2-digit", minute: "2-digit", hourCycle: "h23" as const } : {}),
});
---

<span>
  {period ? <><span>De </span><time datetime={start.toISOString()}>{formatter.format(start)}</time><span> até </span>{end ? <time datetime={end.toISOString()}>{formatter.format(end)}</time> : <span>atualmente</span>}</> : <>{end && <span>Início: </span>}<time datetime={start.toISOString()}>{formatter.format(start)}</time>{end && <span> · Fim: <time datetime={end.toISOString()}>{formatter.format(end)}</time></span>}</>}
</span>
