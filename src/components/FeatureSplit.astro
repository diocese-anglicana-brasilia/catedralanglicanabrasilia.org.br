---
interface Props {
  id: string;
  imageSrc: string;
  imageAlt: string;
  imagePosition?: "left" | "right";
  backgroundClass?: string;
}

const {
  id,
  imageSrc,
  imageAlt,
  imagePosition = "right",
  backgroundClass = "bg-white",
} = Astro.props;

const contentOrder = imagePosition === "left" ? "order-1 md:order-2" : "order-1";
const imageOrder = imagePosition === "left" ? "order-2 md:order-1" : "order-2";
---

<section id={id} class:list={["py-24", backgroundClass]}>
  <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
    <div class:list={["fade-in", contentOrder]}>
      <slot />
    </div>
    <div class:list={["fade-in", imageOrder]}>
      <img src={imageSrc} alt={imageAlt} class="w-full h-[420px] object-cover rounded-sm shadow-xl" />
    </div>
  </div>
</section>
