---
import SocialLinks from "./SocialLinks.astro";
---

<footer class="site-footer bg-[#1a1a1a] text-gray-400">
  <svg class="footer-pattern" data-footer-pattern aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="footer-pattern" width="1361" height="189" patternUnits="userSpaceOnUse" patternTransform="scale(0.5291005291)">
        <image href="https://cdn.catedralanglicanabrasilia.org.br/malha_rodape.png" x="-14" y="0" width="1389" height="189" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#footer-pattern)" />
  </svg>
  <div class="max-w-6xl mx-auto px-6 text-center">
    <div class="serif text-xl text-white mb-2" data-footer-title>Catedral Anglicana da Ressurreição</div>
    <div class="text-xs tracking-widest uppercase mb-4 text-[var(--gold)]"><a href="https://dab.org.br" class="underline hover:text-white">Diocese Anglicana de Brasília</a>  · <a href="https://ieab.org.br" class="underline hover:text-white">Igreja Episcopal Anglicana do Brasil</a></div>
    <div class="text-sm mb-4 flex justify-center items-center gap-2">
      <SocialLinks iconOnly />
      <a class="inline-flex items-center justify-center min-w-11 min-h-11 hover:text-[var(--gold)]" href="/rss.xml" aria-label="Feed RSS de notícias"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none" /><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" /></svg></a>
    </div>
    <div class="text-xs">© <span id="year"></span> Catedral Anglicana da Ressurreição. Todos os direitos reservados.</div>
  </div>
</footer>

