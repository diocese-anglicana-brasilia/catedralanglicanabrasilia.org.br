---
import ActionButton from "./ActionButton.astro";
import FormField from "./FormField.astro";

const configuredEndpoint = import.meta.env.PUBLIC_CONTACT_API_URL?.trim();
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim();
let endpoint: string | undefined;
try {
  const url = new URL(configuredEndpoint ?? "");
  if (url.protocol === "https:" || (url.protocol === "http:" && ["localhost", "127.0.0.1"].includes(url.hostname))) endpoint = url.href;
} catch { /* Sem endpoint válido, o formulário permanece desativado. */ }
if (!siteKey) endpoint = undefined;
---

<form
  data-contact-form
  data-contact-endpoint={endpoint}
  class="bg-white p-8 rounded-sm shadow-lg space-y-4"
>
  <FormField id="nome" label="Nome" required>
    <input id="nome" name="nome" type="text" autocomplete="name" required class="w-full border border-gray-300 rounded-sm px-4 py-2 focus:outline-none focus:border-[var(--gold)]" />
  </FormField>
  <FormField id="email" label="E-mail" required>
    <input id="email" name="email" type="email" autocomplete="email" required class="w-full border border-gray-300 rounded-sm px-4 py-2 focus:outline-none focus:border-[var(--gold)]" />
  </FormField>
  <FormField id="assunto" label="Assunto">
    <select id="assunto" name="assunto" class="w-full border border-gray-300 rounded-sm px-4 py-2 focus:outline-none focus:border-[var(--gold)]">
      <option>Informações gerais</option>
      <option>Casamento</option>
      <option>Batismo</option>
      <option>Visita à comunidade</option>
      <option>Doações</option>
    </select>
  </FormField>
  <FormField id="mensagem" label="Mensagem" required>
    <textarea id="mensagem" name="mensagem" rows="4" required class="w-full border border-gray-300 rounded-sm px-4 py-2 focus:outline-none focus:border-[var(--gold)]"></textarea>
  </FormField>
  {endpoint && <><div class="cf-turnstile" data-sitekey={siteKey}></div><script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script></>}
  <ActionButton type="submit" disabled={!endpoint} class="w-full py-3 font-semibold tracking-wide">Enviar mensagem</ActionButton>
  <p
    data-form-status
    class="min-h-5 text-sm text-gray-600"
    role="status"
    aria-live="polite"
  >{endpoint ? "" : <>O envio pelo formulário está temporariamente indisponível. Escreva para <a href="mailto:anglicana309sul@gmail.com" class="underline">anglicana309sul@gmail.com</a>.</>}</p>
</form>
