---
import ActionButton from "./ActionButton.astro";
import FormField from "./FormField.astro";

---

<form
  data-contact-form
  class="bg-white p-8 rounded-sm shadow-lg space-y-4"
>
  <FormField id="nome" label="Nome">
    <input id="nome" name="nome" type="text" autocomplete="name" required class="w-full border border-gray-300 rounded-sm px-4 py-2 focus:outline-none focus:border-[var(--gold)]" />
  </FormField>
  <FormField id="email" label="E-mail">
    <input id="email" name="email" type="email" autocomplete="email" required class="w-full border border-gray-300 rounded-sm px-4 py-2 focus:outline-none focus:border-[var(--gold)]" />
  </FormField>
  <FormField id="assunto" label="Assunto">
    <select id="assunto" name="assunto" class="w-full border border-gray-300 rounded-sm px-4 py-2 focus:outline-none focus:border-[var(--gold)]">
      <option>Informações gerais</option>
      <option>Casamento</option>
      <option>Batismo</option>
      <option>Visita à comunidade</option>
      <option>Doações</option>
    </select>
  </FormField>
  <FormField id="mensagem" label="Mensagem">
    <textarea id="mensagem" name="mensagem" rows="4" required class="w-full border border-gray-300 rounded-sm px-4 py-2 focus:outline-none focus:border-[var(--gold)]"></textarea>
  </FormField>
  <ActionButton type="submit" disabled class="w-full py-3 font-semibold tracking-wide">Enviar mensagem</ActionButton>
  <p
    data-form-status
    class="min-h-5 text-sm text-gray-600"
    role="status"
    aria-live="polite"
  >O envio pelo formulário está temporariamente indisponível. Escreva para <a href="mailto:anglicana309sul@gmail.com" class="underline">anglicana309sul@gmail.com</a>.</p>
</form>
