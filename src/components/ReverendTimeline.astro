---
import type { CollectionEntry } from "astro:content";
import DateRange from "./DateRange.astro";

interface Props { reverends: CollectionEntry<"reverends">[] }
const { reverends } = Astro.props;
---

<ol class="reverend-timeline">
  {reverends.map(({ id, data }) => {
    const image = typeof data.photo === "string" ? data.photo : data.photo?.src;
    return <li class="reverend-timeline-item">
      <div class="reverend-timeline-content">
        {image && <img class="reverend-timeline-photo" src={image} alt={`Fotografia de ${data.name}`} loading="lazy" />}
        <div>
          <p class="reverend-timeline-date"><DateRange start={data.start_date} end={data.end_date} precision="month" period /></p>
          <h3 class="serif reverend-timeline-name"><a href={`/reverends/${id}`}>{data.name}</a></h3>
          <p class="reverend-timeline-role">{data.role}</p>
        </div>
      </div>
    </li>;
  })}
</ol>

<style>
  .reverend-timeline { position: relative; list-style: none; margin: 1.5rem 0 0; padding: 0; }
  .reverend-timeline::before { content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; transform: translateX(-50%); background: var(--gold); }
  .reverend-timeline-item { position: relative; padding-bottom: 2.5rem; }
  .reverend-timeline-item:last-child { padding-bottom: 0; }
  .reverend-timeline-item::before { content: ""; position: absolute; left: 50%; transform: translateX(-50%); top: 0.35rem; width: 12px; height: 12px; border-radius: 50%; background: var(--gold-dark); border: 2px solid white; }
  .reverend-timeline-content { display: flex; gap: 1.25rem; align-items: flex-start; width: calc(50% - 1.75rem); }
  .reverend-timeline-item:nth-child(odd) .reverend-timeline-content { flex-direction: row-reverse; text-align: right; }
  .reverend-timeline-item:nth-child(even) .reverend-timeline-content { margin-left: calc(50% + 1.75rem); }
  .reverend-timeline-photo { width: 5.5rem; height: 5.5rem; object-fit: cover; border-radius: 50%; flex: none; }
  .reverend-timeline-date { color: #595959; font-size: 0.875rem; }
  .reverend-timeline-name { font-size: 1.5rem; line-height: 1.2; margin-top: 0.4rem; }
  .reverend-timeline-name a { color: var(--gold-dark); text-decoration: underline; }
  .reverend-timeline-role { margin-top: 0.3rem; color: #374151; }
  @media (max-width: 640px) {
    .reverend-timeline::before, .reverend-timeline-item::before { left: 6px; }
    .reverend-timeline-content, .reverend-timeline-item:nth-child(even) .reverend-timeline-content { width: auto; margin-left: 2rem; gap: 0.75rem; }
    .reverend-timeline-item:nth-child(odd) .reverend-timeline-content { flex-direction: row; text-align: left; }
    .reverend-timeline-photo { width: 4rem; height: 4rem; }
  }
</style>
