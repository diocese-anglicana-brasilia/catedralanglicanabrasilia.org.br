---
interface Props { iconOnly?: boolean }
const { iconOnly = false } = Astro.props;
---

<nav aria-label="Redes sociais" class="flex flex-wrap gap-x-5 gap-y-2">
  <a class:list={["hover:text-[var(--gold)]", iconOnly ? "inline-flex items-center justify-center min-w-11 min-h-11" : "underline"]} href="https://www.instagram.com/catedralanglicanadebrasilia/" aria-label={iconOnly ? "Instagram" : undefined}>
    {iconOnly ? <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg> : "Instagram"}
  </a>
</nav>
