---
import ActionLink from "../components/ActionLink.astro";
import BackgroundScreen from "../components/BackgroundScreen.astro";
import ContactDetails from "../components/ContactDetails.astro";
import ContactForm from "../components/ContactForm.astro";
import Footer from "../components/Footer.astro";
import FeatureSplit from "../components/FeatureSplit.astro";
import Header from "../components/Header.astro";
import InfoCards from "../components/InfoCards.astro";
import CardGrid from "../components/CardGrid.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
import { newsCard, publishedNews } from "../utils/news";
import { eventCard, isCurrentOrUpcoming, orderEvents } from "../utils/events";

const weddingCards = [
  {
    title: "Preparação",
    description: "Encontros com o clero para discernimento e preparação espiritual do casal.",
  },
  {
    title: "Cerimônia",
    description: "Celebração litúrgica completa com música sacra e participação da comunidade.",
  },
  {
    title: "Agendamento",
    description: "Procure a secretaria com antecedência mínima de 6 meses.",
  },
];

const sacramentCards = [
  {
    title: "Santa Eucaristia",
    description: "Celebrada todos os domingos e em dias santos. É o centro da vida litúrgica, onde recebemos o Corpo e o Sangue de Cristo.",
  },
  {
    title: "Confirmação",
    description: "Sacramento no qual o bispo impõe as mãos sobre os fiéis, fortalecendo-os com o Espírito Santo para a vida cristã adulta.",
  },
  {
    title: "Unção dos Enfermos",
    description: "Ministério de cura e consolação, oferecido a quem enfrenta enfermidades, cirurgias ou momentos de fragilidade.",
  },
];

const contactDetails = [
  {
    icon: "📍",
    label: "Endereço",
    value: "Brasília — Distrito Federal, Brasil",
  },
  {
    icon: "✉",
    label: "E-mail",
    value: "contato@catedralanglicanabsb.org.br",
    href: "mailto:contato@catedralanglicanabsb.org.br",
  },
  {
    icon: "☎",
    label: "Telefone",
    value: "(61) 0000-0000",
  },
  {
    icon: "🕐",
    label: "Cultos dominicais",
    value: "Domingos às 10h — Santa Eucaristia",
  },
];

const [news, events, about, contact, donate] = await Promise.all([
  getCollection("news", ({ data }) => data.status === "published"),
  getCollection("events"),
  getEntry("pages", "about"),
  getEntry("pages", "contact"),
  getEntry("pages", "donate"),
]);
const featuredNews = publishedNews(news).slice(0, 3);
const homeSeo = await getEntry("site_seo", "home");
const now = new Date();
const featuredEvents = orderEvents(events.filter(({ data }) => isCurrentOrUpcoming(data, now)), now).slice(0, 3);
---

<BaseLayout title="Catedral Anglicana da Ressureição" description={homeSeo?.data.seo_description} keywords={homeSeo?.data.seo_keywords}>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo principal</a>
  <Header />

  <main id="conteudo" tabindex="-1">
    <section
      id="inicio"
      class="relative h-screen min-h-[600px] img-section flex items-center justify-center"
      style="background-image: url('https://image.qwenlm.ai/public_source/cec2c68e-5217-4566-a18a-8766f0795999/183af1eb3-1849-4f13-b0be-9a5e1c1b1635.png');"
    >
      <div class="absolute inset-0 hero-overlay"></div>
      <div class="relative z-10 text-center text-white px-6 max-w-4xl fade-in">
        <div class="text-xs tracking-[0.4em] uppercase mb-4 text-[var(--gold)]">Diocese Anglicana de Brasília</div>
        <h1 class="serif text-5xl md:text-7xl font-bold leading-tight mb-6">Catedral Anglicana<br />da Ressureição</h1>
        <p class="text-lg md:text-xl font-light max-w-2xl mx-auto mb-10 text-gray-100">
          Uma comunidade de fé, esperança e amor no coração do Distrito Federal, pertencente à
          <strong>Igreja Episcopal Anglicana do Brasil</strong>.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <ActionLink href="#doacoes" size="hero">Contribua</ActionLink>
          <ActionLink href="#contato" variant="light-outline" size="hero">Visite-nos</ActionLink>
        </div>
      </div>
    </section>

    <FeatureSplit
      id="doacoes"
      imageSrc="https://image.qwenlm.ai/public_source/cec2c68e-5217-4566-a18a-8766f0795999/1020c7f2e-1b46-4e79-bbd6-fb777f81c34a.png"
      imageAlt="Comunidade em oração"
    >
      <SectionHeading eyebrow="Sustente a missão" title="Faça sua doação" />
      <p class="text-gray-700 leading-relaxed mb-5">
        Sua contribuição mantém viva a missão da Catedral Anglicana de Brasília: celebrar os sacramentos,
        acolher os que buscam, servir aos necessitados e anunciar o Evangelho de Cristo na capital do Brasil.
      </p>
      <p class="text-gray-700 leading-relaxed mb-8">
        Os recursos são destinados à manutenção do templo, projetos sociais, formação de lideranças e apoio às
        famílias da nossa comunidade.
      </p>
      <div class="bg-[var(--cream)] border-l-4 border-[var(--gold)] p-6 rounded-sm">
        <h3 class="serif text-xl font-bold mb-3">Chave Pix</h3>
        <div class="font-mono text-sm break-all text-gray-800">catedral.anglicana.bsb@ieab.org.br</div>
        <div class="mt-4 text-xs text-gray-600">Catedral Anglicana da Ressureição — Diocese Anglicana de Brasília</div>
      </div>
      <ActionLink href="#contato" variant="underlined" class="mt-8">
        Entre em contato para outras formas de contribuição →
      </ActionLink>
      {donate && <p class="mt-4"><a class="underline text-[var(--gold-dark)]" href="/pages/donate">Mais informações sobre doações</a></p>}
    </FeatureSplit>

    <BackgroundScreen
      id="casamentos"
      imageSrc="https://image.qwenlm.ai/public_source/cec2c68e-5217-4566-a18a-8766f0795999/1d7202bc0-f1a2-4623-914c-68f8a6b8b65f.png"
      overlayClass="hero-image-overlay"
      contentClass="max-w-5xl mx-auto px-6 text-center text-white fade-in"
    >
      <div class="text-xs tracking-[0.3em] uppercase text-[var(--gold)] mb-3">Celebre o amor</div>
      <h2 class="serif text-4xl md:text-6xl font-bold mb-6">Casamentos</h2>
      <p class="text-lg md:text-xl font-light max-w-3xl mx-auto leading-relaxed mb-8">
        O matrimônio é um sacramento no qual duas pessoas se unem diante de Deus e da comunidade. Na Catedral
        Anglicana de Brasília, celebramos uniões com reverência, beleza e profundo significado espiritual.
      </p>
      <div class="mt-12">
        <InfoCards items={weddingCards} variant="overlay" />
      </div>
    </BackgroundScreen>

    <FeatureSplit
      id="batismos"
      imageSrc="https://image.qwenlm.ai/public_source/cec2c68e-5217-4566-a18a-8766f0795999/1eb7b7dc9-12e6-4f5f-9ba7-2c53a7e19cee.png"
      imageAlt="Pia batismal e mesa de comunhão"
      imagePosition="left"
      backgroundClass="bg-[var(--cream)]"
    >
      <SectionHeading eyebrow="Início da jornada de fé" title="Batismos" />
      <p class="text-gray-700 leading-relaxed mb-5">
        O Batismo é o sacramento de iniciação cristã, pelo qual somos incorporados ao Corpo de Cristo e recebemos
        o dom do Espírito Santo. Celebramos batismos de crianças, jovens e adultos.
      </p>
      <ul class="space-y-3 text-gray-700">
        <li class="flex gap-3"><span class="text-[var(--gold)] font-bold" aria-hidden="true">✦</span> Celebrações mensais durante a Eucaristia dominical</li>
        <li class="flex gap-3"><span class="text-[var(--gold)] font-bold" aria-hidden="true">✦</span> Preparação para pais e padrinhos</li>
        <li class="flex gap-3"><span class="text-[var(--gold)] font-bold" aria-hidden="true">✦</span> Acolhimento de todas as idades</li>
      </ul>
      <ActionLink href="#contato" class="mt-8">Agende uma conversa</ActionLink>
    </FeatureSplit>

    <section id="sacramentos" class="py-24 bg-white">
      <div class="max-w-5xl mx-auto px-6 text-center fade-in">
        <SectionHeading eyebrow="Vida sacramental" title="Sacramentos" align="center" />
        <p class="text-gray-700 leading-relaxed max-w-3xl mx-auto mb-14">
          A Igreja Anglicana reconhece dois sacramentos maiores instituídos por Cristo — o Batismo e a Eucaristia — e
          cinco sacramentos menores (ou "sacramentais"): Confirmação, Ordem, Matrimônio, Penitência e Unção dos Enfermos.
        </p>
        <InfoCards items={sacramentCards} />
      </div>
    </section>

    <BackgroundScreen
      id="historia"
      imageSrc="https://image.qwenlm.ai/public_source/cec2c68e-5217-4566-a18a-8766f0795999/174c7ea35-1312-4afa-a815-7d916676c522.png"
      overlayClass="hero-image-overlay"
      contentClass="max-w-4xl mx-auto px-6 text-white fade-in"
    >
      <div class="text-xs tracking-[0.3em] uppercase text-[var(--gold)] mb-3 text-center">Nossa trajetória</div>
      <h2 class="serif text-4xl md:text-6xl font-bold mb-8 text-center">Breve História</h2>
      <div class="space-y-5 text-lg font-light leading-relaxed text-gray-100">
        <p>A <strong>Igreja Episcopal Anglicana do Brasil (IEAB)</strong> é uma igreja cristã de tradição apostólica, parte da Comunhão Anglicana mundial, com raízes que remontam à Reforma do século XVI e à Igreja da Inglaterra.</p>
        <p>A <strong>Diocese Anglicana de Brasília</strong> abrange o Distrito Federal e regiões do entorno, sendo a Catedral Anglicana da Ressureição sua igreja-mãe. Desde sua fundação, a diocese tem sido um espaço de acolhimento, diálogo ecumênico e compromisso com a justiça social.</p>
        <p>A Catedral, situada no coração da capital federal, é um lugar de oração, celebração e serviço, onde a liturgia anglicana — rica em beleza, tradição e abertura — encontra o povo brasileiro em sua diversidade.</p>
        {about && <p><a class="underline" href="/pages/about">Mais sobre a Catedral</a></p>}
      </div>
    </BackgroundScreen>

    {featuredNews.length > 0 && <section id="noticias" class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="serif text-4xl font-bold mb-8">Notícias</h2>
        <CardGrid items={featuredNews.map(newsCard)} emptyMessage="Ainda não há notícias publicadas." />
        <a class="inline-block mt-8 underline text-[var(--gold-dark)] font-semibold" href="/news/">Ver todas as notícias</a>
      </div>
    </section>}

    {featuredEvents.length > 0 && <section id="eventos" class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="serif text-4xl font-bold mb-8">Eventos</h2>
        <CardGrid items={featuredEvents.map(eventCard)} emptyMessage="Ainda não há eventos cadastrados." />
        <a class="inline-block mt-8 underline text-[var(--gold-dark)] font-semibold" href="/events/">Ver todos os eventos</a>
      </div>
    </section>}

    <section id="contato" class="py-24 bg-[var(--cream)]">
      <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-12">
        <div class="fade-in">
          <div class="text-xs tracking-[0.3em] uppercase text-[var(--gold-dark)] mb-3">Fale conosco</div>
          <h2 class="serif text-4xl md:text-5xl font-bold mb-6">Contato</h2>
          <p class="text-gray-700 leading-relaxed mb-8">Será uma alegria recebê-lo em nossa comunidade. Entre em contato para visitas, informações sobre sacramentos, agendamentos ou qualquer dúvida.</p>
          <ContactDetails items={contactDetails} />
          {contact && <p class="mt-6"><a class="underline text-[var(--gold-dark)]" href="/pages/contact">Mais informações de contato</a></p>}
        </div>
        <div class="fade-in">
          <ContactForm />
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    import "../scripts/site.js";
  </script>
</BaseLayout>
