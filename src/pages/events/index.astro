---
import { getCollection } from "astro:content";
import ContentArchive from "../../components/ContentArchive.astro";
import { eventCard, eventsPageHref, orderEvents } from "../../utils/events";
import { paginateItems } from "../../utils/pagination";
import EventCalendar from "../../components/EventCalendar.astro";

const events = orderEvents(await getCollection("events"));
const pages = paginateItems(events);
---

<ContentArchive title="Eventos" items={pages[0].map(eventCard)} emptyMessage="Ainda não há eventos cadastrados." currentPage={1} totalPages={pages.length} getPageHref={eventsPageHref}>
  <EventCalendar slot="before-list" events={events} />
</ContentArchive>
