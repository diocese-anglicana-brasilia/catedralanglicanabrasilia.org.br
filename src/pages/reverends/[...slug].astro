---
import { getCollection, render, type CollectionEntry } from "astro:content";
import DateRange from "../../components/DateRange.astro";
import PersonProfile from "../../components/PersonProfile.astro";

export async function getStaticPaths() {
  const reverends = await getCollection("reverends");
  return reverends.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"reverends">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, role, bio, photo, start_date, end_date } = entry.data;
const imageSrc = typeof photo === "string" ? photo : photo?.src;
---

<PersonProfile name={name} role={role} bio={bio} imageSrc={imageSrc} backHref="/pages/reverends-gallery" backLabel="Voltar à galeria de reverendo(a)s">
  <p slot="details" class="text-gray-600 mb-6"><DateRange start={start_date} end={end_date} /></p>
  <Content />
</PersonProfile>
