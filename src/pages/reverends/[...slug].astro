---
import { getCollection, render, type CollectionEntry } from "astro:content";
import DateRange from "../../components/DateRange.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const reverends = await getCollection("reverends");
  return reverends.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"reverends">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, role, bio, photo, start_date, end_date } = entry.data;
const imageSrc = typeof photo === "string" ? photo : photo?.src;
---

<BaseLayout title={`${name} | Catedral Anglicana de Brasília`}>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo principal</a>
  <Header isHomePage={false} />
  <main id="conteudo" tabindex="-1" class="min-h-screen bg-[var(--cream)] px-6 py-32">
    <article class="max-w-4xl mx-auto bg-white p-8 md:p-12 rounded-sm shadow-sm">
      <h1 class="serif text-4xl md:text-5xl font-bold mb-4">{name}</h1>
      <p class="text-lg text-gray-700 mb-2">{role}</p>
      <p class="text-gray-600 mb-6"><DateRange start={start_date} end={end_date} /></p>
      {imageSrc && <img src={imageSrc} alt={`Fotografia de ${name}`} class="w-full max-w-sm max-h-[32rem] object-cover mb-8" />}
      {bio && <div class="content-body text-gray-700 leading-relaxed whitespace-pre-line"><p>{bio}</p></div>}
      <div class="content-body text-gray-700 leading-relaxed"><Content /></div>
      <p class="mt-10"><a class="underline text-[var(--gold-dark)]" href="/pages/reverends-gallery">Voltar à galeria de reverendo(a)s</a></p>
    </article>
  </main>
  <Footer />
  <script>import "../../scripts/site.js";</script>
</BaseLayout>
