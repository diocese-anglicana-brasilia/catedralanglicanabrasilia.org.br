---
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DateRange from "../../components/DateRange.astro";
import { isActiveMember } from "../../utils/board-members";
import LocationDetails from "../../components/LocationDetails.astro";
import CalendarActions from "../../components/CalendarActions.astro";
import { eventCalendar } from "../../utils/event-calendar";
import { renderEventDescription } from "../../utils/event-markdown";
import { eventLocationData, locationData } from "../../utils/structured-data";

type PublicEntry =
  | CollectionEntry<"news">
  | CollectionEntry<"events">
  | CollectionEntry<"locations">
  | CollectionEntry<"programs">
  | CollectionEntry<"pages">;

export async function getStaticPaths() {
  const [news, events, locations, pages, programs] = await Promise.all([
    getCollection("news", ({ data }) => data.status === "published"),
    getCollection("events"),
    getCollection("locations"),
    getCollection("pages"),
    getCollection("programs"),
  ]);

  return [
    ...news.map((entry) => ({ params: { collection: "news", slug: entry.id }, props: { entry } })),
    ...events.map((entry) => ({ params: { collection: "events", slug: entry.id }, props: { entry } })),
    ...locations.map((entry) => ({ params: { collection: "locations", slug: entry.id }, props: { entry } })),
    ...pages.map((entry) => ({ params: { collection: "pages", slug: entry.id }, props: { entry } })),
    ...programs.map((entry) => ({ params: { collection: "programs", slug: entry.id }, props: { entry } })),
  ];
}

interface Props {
  entry: PublicEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = "title" in entry.data ? entry.data.title : entry.data.name;
const date = "date" in entry.data ? entry.data.date : undefined;
const dateText = date?.toLocaleDateString("pt-BR", { timeZone: "UTC" });
const image = entry.collection === "news" ? entry.data.featured_image : undefined;
const eventLocation = entry.collection === "events" && entry.data.location
  ? await getEntry("locations", entry.data.location)
  : undefined;
const calendarEvent = entry.collection === "events" && Astro.site ? eventCalendar(entry, eventLocation, Astro.site) : undefined;
const eventDescription = entry.collection === "events" && entry.data.description ? renderEventDescription(entry.data.description) : undefined;
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://catedralanglicanabrasilia.org.br";
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const publisher = { "@type": "Organization", "@id": new URL("/#catedral", siteUrl).href, name: "Catedral Anglicana da Ressurreição", url: new URL("/", siteUrl).href };
const structuredData = entry.collection === "news" ? {
  "@context": "https://schema.org", "@type": "NewsArticle", headline: entry.data.title, url: pageUrl,
  datePublished: entry.data.date.toISOString(), inLanguage: "pt-BR", publisher,
  ...(entry.data.excerpt && { description: entry.data.excerpt }),
  ...(image && { image: new URL(typeof image === "string" ? image : image.src, siteUrl).href }),
} : entry.collection === "events" ? {
  "@context": "https://schema.org", "@type": "Event", name: entry.data.name, url: pageUrl,
  startDate: entry.data.start_date.toISOString(),
  ...(entry.data.end_date && { endDate: entry.data.end_date.toISOString() }),
  ...(entry.data.seo_description && { description: entry.data.seo_description }),
  ...(eventLocation && eventLocationData(eventLocation, siteUrl) && { location: eventLocationData(eventLocation, siteUrl) }),
} : entry.collection === "locations" ? {
  "@context": "https://schema.org", ...locationData(entry, siteUrl),
  ...(entry.data.seo_description && { description: entry.data.seo_description }),
} : undefined;
const memberIds = entry.collection === "pages" ? entry.data.board_members ?? [] : [];
const matchingMembers = memberIds.length
  ? await getCollection("board_members", ({ id }) => memberIds.includes(id))
  : [];
const relatedMembers = memberIds.flatMap((id) => matchingMembers.filter((member) => member.id === id));
const reverendIds = entry.collection === "pages" ? entry.data.reverends ?? [] : [];
const matchingReverends = reverendIds.length
  ? await getCollection("reverends", ({ id }) => reverendIds.includes(id))
  : [];
const relatedReverends = reverendIds.flatMap((id) => matchingReverends.filter((reverend) => reverend.id === id));
const relatedPrograms = entry.collection === "pages" && entry.data.programs?.length
  ? await getCollection("programs", ({ id }) => entry.data.programs?.includes(id) ?? false)
  : [];
---

<BaseLayout title={`${title} | Catedral Anglicana da Ressureição`} description={entry.data.seo_description} keywords={entry.data.seo_keywords} structuredData={structuredData}>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo principal</a>
  <Header isHomePage={false} />
  <main id="conteudo" tabindex="-1" class="min-h-screen bg-[var(--cream)] px-6 py-32">
    <article class="max-w-4xl mx-auto bg-white p-8 md:p-12 rounded-sm shadow-sm">
      <h1 class="serif text-4xl md:text-5xl font-bold mb-6">{title}</h1>
      {entry.collection === "events" ? (
        <p class="text-gray-600 mb-6"><DateRange start={entry.data.start_date} end={entry.data.end_date} showTime timeZone="America/Sao_Paulo" /> <span>(horário de Brasília)</span></p>
      ) : date && <p class="text-gray-600 mb-6"><time datetime={date.toISOString()}>{dateText}</time></p>}
      {image && <img src={typeof image === "string" ? image : image.src} alt="" class="w-full max-h-[32rem] object-cover mb-8" />}
      {eventDescription && <div class="content-body text-gray-700 leading-relaxed mb-6" data-event-description set:html={eventDescription} />}
      {eventLocation && <p class="mb-6"><strong>Local: </strong><a class="underline text-[var(--gold-dark)]" href={`/locations/${eventLocation.id}`}>{eventLocation.data.name}</a></p>}
      {entry.collection === "programs" && <p class="mb-6">{entry.data.description}</p>}
      {entry.collection === "programs" && entry.data.goals?.length && <section class="mb-6"><h2 class="serif text-2xl font-bold mb-4">Objetivos</h2><ul class="list-disc pl-6">{entry.data.goals.map((goal) => <li>{goal}</li>)}</ul></section>}
      {entry.collection === "programs" && entry.data.impact && <section class="mb-6"><h2 class="serif text-2xl font-bold mb-4">Impacto</h2><p>{entry.data.impact}</p></section>}
      {entry.collection === "locations" && <LocationDetails location={entry.data} />}
      <div class="content-body text-gray-700 leading-relaxed"><Content /></div>
      {relatedMembers.length > 0 && <section class="mt-8"><h2 class="serif text-2xl font-bold mb-4">Junta Paroquial</h2><ul class="space-y-3">{relatedMembers.map(({ id, data }) => <li><strong>{isActiveMember(data) ? <a class="underline text-[var(--gold-dark)]" href={`/board-members/${id}`}>{data.name}</a> : data.name}</strong> — {data.role}{data.bio && <p>{data.bio}</p>}</li>)}</ul></section>}
      {relatedReverends.length > 0 && <section class="mt-8"><h2 class="serif text-2xl font-bold mb-4">Reverendo(a)s</h2><ul class="space-y-3">{relatedReverends.map(({ id, data }) => <li><strong><a class="underline text-[var(--gold-dark)]" href={`/reverends/${id}`}>{data.name}</a></strong> — {data.role}{data.bio && <p>{data.bio}</p>}</li>)}</ul></section>}
      {relatedPrograms.length > 0 && <section class="mt-8"><h2 class="serif text-2xl font-bold mb-4">Atividades</h2><ul class="space-y-3">{relatedPrograms.map(({ data }) => <li><strong>{data.name}</strong><p>{data.description}</p></li>)}</ul></section>}
      {entry.collection === "events" && entry.data.registration_url && (
        <p class="mt-6"><a class="underline text-[var(--gold-dark)]" href={entry.data.registration_url}>Inscreva-se</a></p>
      )}
      {calendarEvent && <CalendarActions event={calendarEvent} />}
      <p class="mt-10"><a class="underline text-[var(--gold-dark)]" href="/">Voltar à página inicial</a></p>
    </article>
  </main>
  <Footer />
  <script>import "../../scripts/site.js";</script>
</BaseLayout>
