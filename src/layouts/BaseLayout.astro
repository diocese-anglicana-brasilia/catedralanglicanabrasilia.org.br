---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string | null;
  keywords?: string | null;
  canonicalPath?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description: suppliedDescription,
  keywords,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  structuredData: pageStructuredData,
} = Astro.props;
const description = suppliedDescription?.trim() || "Catedral Anglicana da Ressureição: uma comunidade de fé, esperança e amor no coração do Distrito Federal.";
const normalizedKeywords = keywords?.trim();
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://catedralanglicanabrasilia.org.br";
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const structuredData = pageStructuredData ?? {
  "@context": "https://schema.org",
  "@type": "ReligiousOrganization",
  name: "Catedral Anglicana da Ressureição",
  url: siteUrl,
  email: "contato@catedralanglicanabsb.org.br",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Brasília",
    addressRegion: "DF",
    addressCountry: "BR",
  },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {normalizedKeywords && <meta name="keywords" content={normalizedKeywords} />}
    <meta name="theme-color" content="#f7f3ec" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Notícias da Catedral Anglicana da Ressureição" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.catedralanglicanabrasilia.org.br" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Alegreya+Sans+SC:wght@300&display=swap" rel="stylesheet" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://cdn.catedralanglicanabrasilia.org.br/media/public/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="https://cdn.catedralanglicanabrasilia.org.br/media/public/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="https://cdn.catedralanglicanabrasilia.org.br/media/public/favicon-16x16.png">
    <link rel="manifest" href="https://cdn.catedralanglicanabrasilia.org.br/media/public/site.webmanifest">
  </head>
  <body>
    <slot />
  </body>
</html>
